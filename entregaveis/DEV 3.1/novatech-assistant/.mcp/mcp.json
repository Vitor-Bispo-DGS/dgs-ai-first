{
  "mcpServers": {
    "filesystem-sdd": {
      "command": "npx",
      "args": ["-y", "@danielsuguimoto/readonly-filesystem-mcp", "./specs/", "./skills/"]
    },
	"filesystem-code": {
		"command": "npx",
		"args": ["-y", "@modelcontextprotocol/server-filesystem", "./src/", "./tests/"]
	},
	"filesystem-docs": {
		"command": "npx",
		"args": ["-y", "@danielsuguimoto/readonly-filesystem-mcp", "./docs/novatech/"]
	},
	"filesystem-retrieval": {
		"command": "npx",
		"args": ["-y", "@danielsuguimoto/readonly-filesystem-mcp", "./data/retrieval-corpus"]
	},
  "git": {
    "command": "python",
    "args": ["-m", "mcp_server_git", "--repository", "."]
  },
  "memory": {
    "command": "cmd",
    "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-memory"]
  },
  "everything": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-everything"]
  }
}
}

